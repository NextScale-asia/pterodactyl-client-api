{
    "name": "nextscale-asia/pterodactyl-client-api",
    "description": "Application API endpoints for managing users' account API keys and listing free allocations in Pterodactyl Panel",
    "keywords": [
        "pterodactyl",
        "laravel",
        "api-addon",
        "api-key-management",
        "client-api",
        "free-allocation"
    ],
    "homepage": "https://github.com/NextScale-asia/Panel-Client-API",
    "license": "MIT",
    "authors": [
        {
            "name": "Byzic",
            "email": "byzic@example.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Byzic\\PterodactylClientApi\\": "src"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Byzic\\PterodactylClientApi\\PterodactylApiAddonServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
