{
    "name": "rene-roscher/pterodactyl-api-addon",
    "description": "This package provides Application API endpoints for managing user API keys in Pterodactyl Panel",
    "keywords": [
        "PterodactylApiAddon",
        "laravel",
        "pterodactyl-api-addon",
        "api-key-management"
    ],
    "homepage": "https://github.com/pterodactylapiaddon/pterodactyl-api-addon",
    "license": "MIT",
    "authors": [
        {
            "name": "Rene Roscher",
            "email": "roscher794@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3",
        "laravel/framework": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Xepare\\PterodactylApiAddon\\": "src"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Xepare\\PterodactylApiAddon\\PterodactylApiAddonServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
